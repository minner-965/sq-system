# 复制为 .env 后填写。.env 不进 Git。

TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hz_leasing
POSTGRES_USER=hz_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# 任务队列与本地追踪
PGBOSS_ENABLED=true
OTEL_ENABLED=false

# 只读维护：true 时页面可看，所有写操作返回 503
DPV_MAINTENANCE_READ_ONLY=false

# 登录功能上线前使用的固定操作身份（WP03 换成账号登录后删除）
DPV_WORKSPACE_ACTOR=admin
DPV_WORKSPACE_ROLE=MANAGEMENT
