# 复制为 .env 后填写。.env 不进 Git。

TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hz_leasing
POSTGRES_USER=hz_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# 任务队列与本地追踪
PGBOSS_ENABLED=true
OTEL_ENABLED=false

# 只读维护：true 时页面可看，所有写操作返回 503
DPV_MAINTENANCE_READ_ONLY=false

# 登录会话的签名密钥，至少 32 位随机字符。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# 高德开放平台“Web 服务”类型的 Key，用于检索周边企业。留空则不能检索。
AMAP_KEY=

# 百度智能云千帆的 API Key（bce-v3/ 开头），用“百度搜索”接口查企业近况。留空则不查需求信号。
BAIDU_SEARCH_KEY=

# 大模型（OpenAI 兼容接口）。默认 DeepSeek；换服务商时再填 LLM_BASE_URL、LLM_API_KEY、LLM_MODEL。
DEEPSEEK_API_KEY=

# 固定公网地址：留资二维码用它。Cloudflare 隧道的连接密钥（publisher/start-tunnel.cmd 读取）。
HZ_PUBLIC_BASE_URL=
HZ_TUNNEL_TOKEN=
