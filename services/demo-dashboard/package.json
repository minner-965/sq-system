{
  "name": "hz-leasing-app",
  "version": "1.0.0",
  "private": true,
  "description": "恒兆广场招商与获客系统",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:host": "node --env-file=../../.env scripts/migrate.mjs --host",
    "check:amap": "node --env-file=../../.env scripts/hz/check-amap.mjs",
    "check:search-llm": "node --env-file=../../.env scripts/hz/check-search-llm.mjs",
    "eval:copy": "node --env-file=../../.env scripts/hz/eval-copy.mjs",
    "eval:intent": "node --env-file=../../.env scripts/hz/eval-intent.mjs",
    "permits:match": "node --env-file=../../.env scripts/hz/check-permits.mjs",
    "signals:check": "node --env-file=../../.env scripts/hz/check-signals.mjs",
    "check:call-log": "node --env-file=../../.env scripts/hz/check-call-log.mjs",
    "check:tender-follow": "node --env-file=../../.env scripts/hz/check-tender-follow.mjs",
    "check:demand": "node --env-file=../../.env scripts/hz/check-demand.mjs",
    "library:import": "node --env-file=../../.env scripts/hz/import-library.mjs",
    "check:library": "node --env-file=../../.env scripts/hz/check-library.mjs",
    "check:lead-form": "node --env-file=../../.env scripts/hz/check-lead-form.mjs",
    "check:publish-rules": "node --env-file=../../.env scripts/hz/check-publish-rules.mjs",
    "user:set": "node --env-file=../../.env scripts/hz/set-user.mjs",
    "import:properties": "node --env-file=../../.env scripts/hz/import-properties.mjs",
    "test:native-smoke": "node scripts/check-native-dependencies.mjs"
