  "dependencies": {
    "@gorules/zen-engine": "2.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@tabler/core": "1.4.0",
    "@tabler/icons-webfont": "3.46.0",
    "chart.js": "4.5.1",
    "cheerio": "1.2.0",
    "connect-pg-simple": "10.0.0",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "libphonenumber-js": "1.13.12",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "pg-boss": "12.28.0",
    "qrcode": "1.5.4",
    "tldts": "7.4.11",
    "umzug": "3.8.3",
    "validator": "13.15.35"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "pdf-to-img": "6.3.0"
  }
